# ==== Telegram ====
BOT_TOKEN=123456:AAAA-your-bot-token-here

# ==== Database ====
DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/bot
# Used by Alembic (sync driver) — same credentials, different DBAPI
DATABASE_URL_SYNC=postgresql+psycopg2://bot:bot@postgres:5432/bot
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot
POSTGRES_DB=bot

# ==== Redis (FSM storage + APScheduler jobstore) ====
REDIS_URL=redis://redis:6379/0

# ==== Admin access ====
# Comma-separated Telegram user IDs allowed into /admin
ADMIN_IDS=123456789
# Optional extra access code required once per admin session. Leave empty to disable.
ADMIN_SECRET_KEY=

# ==== Required subscription channel ====
REQUIRED_CHANNEL_ID=-1001234567890
REQUIRED_CHANNEL_URL=https://t.me/your_channel
REQUIRED_CHANNEL_NAME=Страх Банкира

# ==== Specialist routing ====
# Optional separate chat/group that also receives specialist notifications.
# Leave empty to notify ADMIN_IDS only.
SPECIALIST_CHAT_ID=

# ==== Giveaway ====
GIVEAWAY_POST_URL=https://t.me/your_channel/1

# ==== Reminders ====
REMINDER_DELAY_SECONDS=300
MAX_REMINDERS=3

# ==== File uploads ====
MAX_FILE_SIZE_MB=20

# ==== Overpayment calculation ====
# Ключевое слово для поиска платежей в загруженной PDF-выписке (сумма всех
# найденных строк = переплата). Редактируется в админке (Настройки).
CALCULATION_KEYWORD=страх

# ==== Misc ====
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow
